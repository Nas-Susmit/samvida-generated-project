# Backend environment variables can be set here.
# For this project, DATABASE_URL defaults to SQLite in the project root.
# DATABASE_URL="sqlite:///./sql_app.db"
# To run backend with `uvicorn backend.main:app --reload`
# and frontend with `npm start` (which reads REACT_APP_API_BASE_URL)
# ensure backend is on port 8000 and frontend on 3000.
